# 인증서와 개인키
# gossl 은 현재 디렉토리의 pem, crt, key, ca, csr, cer 파일을 훑는다.
# 실제 인증서를 두고 테스트하다 커밋하는 사고를 막는다.
*.pem
*.crt
*.key
*.ca
*.csr
*.cer
*.der
*.p12
*.pfx
*.jks

# 단, 생성된 루트 인증서 번들은 저장소에 포함한다.
# tools/genroots 가 만들고 go:embed 로 바이너리에 실린다.
!config/roots.pem

# 빌드 산출물
/dist/
/gossl
gossl.exe
/genroots
*.exe

# 테스트 산출물
*.test
coverage.txt
coverage.out
binary.txt
covdata/
*.prof

# 모듈
/vendor/

# 압축 파일 (zip / unzip 명령의 결과)
*.zip
*.tar.gz

# 에디터와 OS
.DS_Store
.idea/
.vscode/
*.swp
