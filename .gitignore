*.pem
*.crt
*.key
*.ca
*.csr
*.cer
*.der
*.p12
*.pfx
*.jks

# 빌드 산출물
/dist/
/gossl
gossl.exe
/genroots
*.exe

# 테스트 산출물
*.test
coverage.txt
coverage.out
*.prof

# 모듈
/vendor/

# 압축 파일 (zip / unzip 명령의 결과)
*.zip
*.tar.gz

# 에디터와 OS
.DS_Store
.idea/
.vscode/
*.swp
